{
  "collectionId": "col-valid-documents",
  "mediaTypeEndpoint": "html",
  "renderer": {
    "css": ["https://dots.chartes.psl.eu/assets/html.css"],
    "documentContainer": "#center",
    "pageSelectors": ["html", "body", ":root"],
    "facsimiles": [
      { "selector": "a.pb[href*='iiif']", "image": { "attribute": "href" } },
      {
        "selector": ".lg figure",
        "image": { "selector": "a img", "attribute": "src" }
      }
    ]
  },
  "documentPageSettings": { "metadataTabLabel": "Notice bibliographique" },
  "collectionCustomJs": "elec",
  "collectionCustomFonts": "elec",
  "homePageSettings": {
    "pageHeader": { "aboutButtonText": "À propos", "aboutOpenState": true },
    "listSection": {
      "displayMode": "toc",
      "singleResourceButtonText": "Accéder au document"
    }
  },
  "footerSettings": { "footerTitle": "T" }
}
